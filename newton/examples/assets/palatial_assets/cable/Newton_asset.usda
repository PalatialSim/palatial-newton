    def PhysicsScene "physicsScene" (
        prepend apiSchemas = ["NewtonSceneAPI"]
    )
    {
        custom token newton:solver = "vbd"
        custom int newton:solver:iterations = 16
        custom int newton:solver:substeps = 10
        uniform int newton:timeStepsPerSecond = 60
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Material "cloth_material" (
        prepend apiSchemas = ["NewtonRodMaterialAPI"]
    )
    {
        float newton:rod:bendDamping = 0.05
        float newton:rod:bendStiffness = 50
        float newton:rod:compressDamping = 0
        float newton:rod:compressStiffness = 10
        float newton:rod:density = 1500
        float newton:rod:stretchDamping = 0
        float newton:rod:stretchStiffness = 1000000
    }
}

