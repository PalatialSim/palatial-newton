#usda 1.0
(
    "Newton deformable USD API schemas for cloth/shell and rod/cable assets. "
    "Sibling plugin to newton-usd-schemas. Defines NewtonDeformableAPI, "
    "NewtonShellAPI, NewtonShellMaterialAPI, NewtonRodAPI, "
    "NewtonRodMaterialAPI, and NewtonClothAPI. See "
    "newton_usd/shell_skill/SKILL.md for the design rationale."
)

class "NewtonDeformableAPI" (
    doc = """Shared base for 2D / 3D / 1D deformable assets (cloth, shell,
    rod, volume, particle, granular). Carries cross-cutting flags. Apply
    alongside the intent-specific API (e.g. NewtonShellAPI for cloth)."""
)
{
    bool newton:deformable:enabled = true (
        doc = "Runtime toggle. When false the loader skips this asset."
    )

    bool newton:deformable:selfCollisionEnabled = false (
        doc = """Whether the deformable should self-collide. Maps to VBD's
        particle_enable_self_contact."""
    )

    uniform token newton:deformable:simulationIntent (
        allowedTokens = ["cloth", "shell", "rod", "volume", "particle", "granular"]
        doc = """Advisory hint for solver dispatch. The cloth/shell prim
        does not pin a solver; the runtime picks SolverVBD by default and
        promotes to SolverStyle3D when style3d:* attrs are authored."""
    )

    float newton:deformable:velocityDamping = 0.0 (
        doc = """Global per-step velocity damping (1/s). Applied uniformly
        to the deformable's particle velocities."""
    )
}

class "NewtonShellAPI" (
    doc = """2D-deformable geometry (cloth, sheets, membranes, thin shells).
    Geometry-level attributes live on the Mesh prim; material-response
    attributes live on the bound Material via NewtonShellMaterialAPI."""
)
{
    float newton:shell:thickness = 0.001 (
        doc = """Shell thickness (m). Drives mass + bending interpretation;
        critical for thin shells. Range: (0, inf)"""
    )

    float newton:shell:particleRadius = 0.01 (
        doc = """Contact radius for VBD/particle-based shell solvers (m).
        Range: (0, inf)"""
    )

    bool newton:shell:addBendingEdges = true (
        doc = """Importer hint: derive bending edges from mesh adjacency
        when building the cloth model."""
    )

    float newton:shell:dropHeight = 1.0 (
        doc = """Sim-time spawn height (m above ground plane). Newton-USD
        convention; not part of the canonical shell schema."""
    )

    float3 newton:shell:style3d:triAnisoKe = (100, 100, 10) (
        doc = """Style3D anisotropic in-plane stiffness (warp, weft, shear)
        in N/m. Authored only for woven fabrics. Maps to
        newton.solvers.style3d.add_cloth_mesh's tri_aniso_ke."""
    )

    float3 newton:shell:style3d:edgeAnisoKe = (2e-5, 1e-5, 5e-6) (
        doc = """Style3D anisotropic bending stiffness (warp-bend, weft-bend,
        shear-bend) in N*m. Maps to add_cloth_mesh's edge_aniso_ke."""
    )

    float newton:shell:vbd:selfContactRadius = 0.2 (
        doc = """VBD particle_self_contact_radius for this asset (m)."""
    )

    float newton:shell:vbd:selfContactMargin = 0.2 (
        doc = """VBD particle_self_contact_margin for this asset (m)."""
    )

    float newton:shell:vbd:conservativeBoundRelaxation = 0.85 (
        doc = """VBD particle_conservative_bound_relaxation for this asset.
        Range: (0, 1]"""
    )
}

class "NewtonShellMaterialAPI" (
    doc = """2D-deformable material response. Apply on a UsdShade.Material
    prim and bind the material to the cloth Mesh via MaterialBindingAPI
    (physics purpose). Mirrors the PhysicsMaterialAPI / NewtonMaterialAPI
    convention for rigid materials."""
)
{
    float newton:shell:density = 300.0 (
        doc = """Bulk density (kg/m^3). Surface density is derived as
        density * thickness at simulation time."""
    )

    float newton:shell:triStiffness = 100.0 (
        doc = """In-plane stretch stiffness, warp/weft averaged (N/m).
        Maps to add_cloth_mesh's tri_ke."""
    )

    float newton:shell:triAreaStiffness = 100.0 (
        doc = """Area-preservation stiffness (N/m). Maps to tri_ka."""
    )

    float newton:shell:triDamping = 0.0 (
        doc = """In-plane damping. Maps to tri_kd."""
    )

    float newton:shell:triDrag = 0.0 (
        doc = """Aerodynamic drag coefficient (dimensionless)."""
    )

    float newton:shell:triLift = 0.0 (
        doc = """Aerodynamic lift coefficient (dimensionless)."""
    )

    float newton:shell:bendStiffness = 0.001 (
        doc = """Bending stiffness (N*m). The single most important fabric
        param. Maps to add_cloth_mesh's edge_ke."""
    )

    float newton:shell:bendDamping = 0.0 (
        doc = """Bending damping. Maps to edge_kd."""
    )
}

class "NewtonRodAPI" (
    prepend apiSchemas = ["NewtonDeformableAPI"]
    doc = """1D-deformable rod or cable geometry. Apply on the cable root
    prim (Xform or Scope) and on the authored BasisCurves centerline prim.
    Material-response attributes live on the bound Material via
    NewtonRodMaterialAPI."""
)
{
    uniform token newton:rod:frameDefinition = "parallelTransport" (
        allowedTokens = ["parallelTransport"]
        doc = """Frame convention used to interpret per-segment
        orientation. The palatial rod loader expects parallel transport
        frames."""
    )

    bool newton:rod:closed = false (
        doc = "If true, close the rod or cable into a loop."
    )

    uniform token newton:rod:crossSectionType = "roundSolid" (
        allowedTokens = ["roundSolid", "flatRect"]
        doc = """Cross-section kind. roundSolid maps directly to stock
        add_rod(); flatRect is approximated in the stock phase."""
    )

    float newton:rod:radius = 0.005 (
        doc = "Round cable radius [m]."
    )

    float newton:rod:width = 0.01 (
        doc = "Flat rectangular cable width [m]."
    )

    float newton:rod:thickness = 0.002 (
        doc = "Flat rectangular cable thickness [m]."
    )

    int newton:rod:segmentCount = 16 (
        doc = "Number of rod segments. Number of points is segmentCount + 1."
    )

    float newton:rod:length = 1.0 (
        doc = """Centerline length [m]. Prefer authoring this on the
        BasisCurves centerline prim."""
    )

    float newton:rod:dropHeight = 0.3 (
        doc = """Palatial loader convenience height [m]. Only used when the
        loader needs to synthesize a straight centerline because no
        BasisCurves points were authored."""
    )

    float newton:rod:twistTotal = 0.0 (
        doc = """Palatial loader convenience total twist [rad]. Applied when
        generating segment quaternions from the centerline."""
    )
}

class "NewtonRodMaterialAPI" (
    doc = """1D-deformable rod or cable material response. Apply on a
    UsdShade.Material prim and bind it to the cable root or centerline via
    MaterialBindingAPI."""
)
{
    float newton:rod:density = 1000.0 (
        doc = "Bulk density [kg/m^3]."
    )

    float newton:rod:stretchStiffness = 100000.0 (
        doc = "Axial tension stiffness [N/m]."
    )

    float newton:rod:stretchDamping = 0.0 (
        doc = "Axial tension damping."
    )

    float newton:rod:compressStiffness = 100000.0 (
        doc = "Axial compression stiffness [N/m]."
    )

    float newton:rod:compressDamping = 0.0 (
        doc = "Axial compression damping."
    )

    float newton:rod:bendYStiffness = 1000.0 (
        doc = "Bend stiffness around one transverse local axis [N*m]."
    )

    float newton:rod:bendYDamping = 0.0 (
        doc = "Bend damping around one transverse local axis."
    )

    float newton:rod:bendZStiffness = 1000.0 (
        doc = "Bend stiffness around the other transverse local axis [N*m]."
    )

    float newton:rod:bendZDamping = 0.0 (
        doc = "Bend damping around the other transverse local axis."
    )

    float newton:rod:torsionStiffness = 1000.0 (
        doc = "Torsion stiffness around the local tangent axis [N*m]."
    )

    float newton:rod:torsionDamping = 0.0 (
        doc = "Torsion damping around the local tangent axis."
    )
}

class "NewtonClothAPI" (
    prepend apiSchemas = ["NewtonShellAPI"]
    doc = """Back-compat alias for NewtonShellAPI. Resolves to the same
    underlying attributes via the shell-first resolution layer. Prefer
    NewtonShellAPI for new authoring."""
)
{
}
